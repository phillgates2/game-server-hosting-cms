# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/gsm

# Secret used to sign session JWTs. Must be at least 32 characters; the app
# refuses to start in production without it.
#   openssl rand -hex 32
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# SMTP, used by the email settings panel.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Default Discord webhook for server notifications. Also configurable from the
# Settings panel, which takes precedence over this value.
# DISCORD_WEBHOOK_URL=

# Optional: a bot token + server (guild) ID lets the panel create a Discord
# channel for each new game server. A webhook alone cannot do this - creating
# channels requires a bot with the Manage Channels and Manage Webhooks
# permissions. Both are also settable from the Settings panel.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=

# ── Discord status boards & channel headings ─────────────────────────────────
#
# One background loop runs both. It keeps a server's live status-board message
# current (for servers whose board is switched on in Settings → Discord), and
# it keeps the 🟢/🔴 status in the channel *name* current for every channel the
# panel created - that heading needs the bot token above, not a webhook, and no
# board message has to be posted for it to work. An up/down change is applied
# immediately (start, stop, restart and crash included); a changed player count
# or map waits its turn, because Discord allows only two channel renames per
# ten minutes. Set this to true to run neither.
# GSM_DISABLE_STATUS_BOARDS=false

# ── Server boot behaviour ─────────────────────────────────────────────────────

# Servers flagged "Start on node boot" are relaunched when the panel starts.
# Set this to true to suppress that, e.g. on a staging copy of a production
# database where you do not want game servers coming up.
# GSM_DISABLE_AUTOSTART=false

# ── File transfer (FTP/FTPS) ─────────────────────────────────────────────────
#
# The panel runs its own FTP/FTPS server so users can push large files (mod
# packs, map rotations, world saves) straight into their server folder. The
# browser uploader has to buffer the whole file in memory, which is fine for a
# config file and hopeless for a big archive.
#
# The listener is on by default. Everything below is also editable at runtime
# under Servers → File Transfer (permission panel.settings), and the stored
# value wins over .env. GSM_DISABLE_FTP is the one switch that has no UI:
#
# GSM_DISABLE_FTP=true          # keep the listener off entirely
# GSM_FTP_ENABLED=true
# GSM_FTP_PORT=2121
# GSM_FTP_BIND=0.0.0.0
#
# The hostname clients should be told to dial back for passive transfers —
# set this whenever the panel is behind NAT, a tunnel or a reverse proxy.
# GSM_FTP_MASQUERADE_HOST=ftp.example.com
#
# Passive data connections. Open this range in the firewall too (TCP); the
# File Transfer panel has one-click UFW buttons for the control port and range.
# GSM_FTP_PASSIVE_PORTS=50000-50100
#
# Optional explicit FTPS (AUTH TLS): a PEM certificate + key the panel process
# can read. Without them the server still runs, in plain FTP.
# GSM_FTP_TLS_CERT=/etc/gsm/ftp.crt
# GSM_FTP_TLS_KEY=/etc/gsm/ftp.key
#
# Drop idle connections after N seconds; cap concurrent sessions.
# GSM_FTP_IDLE_TIMEOUT=300
# GSM_FTP_MAX_CONNECTIONS=64
#
# Refuse a single upload above N MB (0 = unlimited, the default — the whole
# point is large files).
# GSM_FTP_MAX_UPLOAD_MB=0
#
# Key that encrypts the FTP passwords stored for the panel. Defaults to
# JWT_SECRET. Set a dedicated value if you rotate JWT_SECRET regularly: existing
# logins then need a rotation in the panel instead of silently failing.
# GSM_FILE_TRANSFER_SECRET=

# ── Access gate (CD-key style) ───────────────────────────────────────────────
# Master key (min 16 chars): guards the web installer on fresh panels and
# always opens the login gate — the never-lock-yourself-out key.
# install.sh generates one by default and prints it once.
# GSM_PANEL_MASTER_KEY=
# Force the login gate on/off, overriding the Settings → Access Gate toggle.
# GSM_ACCESS_GATE=off

# ── Logging ───────────────────────────────────────────────────────────────────

# Output is tagged [subsystem] and human-readable by default. Set json to emit
# one JSON object per line for a log shipper that parses them.
# GSM_LOG_FORMAT=text
# GSM_LOG_LEVEL=info

# ── WolfET chat bot extras ────────────────────────────────────────────────────

# !etallofoz also probes ET servers that are NOT installed in the panel.
# One host:port or host:port:queryPort per line (the Discord settings field
# does the same and takes precedence; "#" starts a comment).
# GSM_ET_EXTRA_SERVERS=203.44.23.44:27960

# Optional ET master servers for automatic discovery, host or host:port
# entries (default port 27950, unless :27900 is given as in the game's
# sv_master5). Defaults to the classic community list — etmaster.idsoftware.com,
# master0.etmaster.net, master3.idsoftware.com, wolfmaster.idsoftware.com,
# master3.idsoftware.com:27900 and master.etlegacy.com. Discovered servers are
# capped at 25 per command and never duplicated against panel servers.
# Empty = discovery off.
# GSM_ET_MASTER_URLS=master0.etmaster.net:27950

# ── Data retention ────────────────────────────────────────────────────────────

# node_metrics and server_metrics are append-only: a node heartbeating every
# 10s writes ~8,600 rows a day. Samples older than this many days are pruned
# opportunistically from the heartbeat path. Set to 0 to keep everything.
#
# Both windows are also editable under Settings in the panel, which overrides
# whatever is set here.
# METRICS_RETENTION_DAYS=30

# Audit history is usually a compliance concern, so it is kept far longer.
# Set to 0 to keep everything forever.
# AUDIT_RETENTION_DAYS=365
