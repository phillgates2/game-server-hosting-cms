# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/gsm

# Secret used to sign session JWTs. Must be at least 32 characters; the app
# refuses to start in production without it.
#   openssl rand -hex 32
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# SMTP, used by the email settings panel.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Default Discord webhook for server notifications. Also configurable from the
# Site Editor, which takes precedence over this value.
# DISCORD_WEBHOOK_URL=

# Optional: a bot token + server (guild) ID lets the panel create a Discord
# channel for each new game server. A webhook alone cannot do this - creating
# channels requires a bot with the Manage Channels and Manage Webhooks
# permissions. Both are also settable from the Site Editor.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=

# ── Data retention ────────────────────────────────────────────────────────────

# node_metrics and server_metrics are append-only: a node heartbeating every
# 10s writes ~8,600 rows a day. Samples older than this many days are pruned
# opportunistically from the heartbeat path. Set to 0 to keep everything.
# METRICS_RETENTION_DAYS=30

# Audit history is usually a compliance concern, so it is kept far longer.
# Set to 0 to keep everything forever.
# AUDIT_RETENTION_DAYS=365
